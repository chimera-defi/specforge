# SpecForge Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# Application
NODE_ENV=production
PORT=3000

# Domain Configuration
NEXT_PUBLIC_WEB_URL=https://specforge.example.com
NEXT_PUBLIC_COLLAB_SERVER_URL=wss://collab.specforge.example.com

# Database Configuration
# For production, use PostgreSQL instead of pglite
DATABASE_URL=postgresql://user:password@localhost:5432/specforge
PGHOST=localhost
PGPORT=5432
PGDATABASE=specforge
PGUSER=specforge
PGPASSWORD=your_secure_password

# Authentication
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
SPECFORGE_GITHUB_REDIRECT_URI=https://specforge.example.com/api/auth/callback
SPECFORGE_JWT_SECRET=your_jwt_secret_min_32_chars
SPECFORGE_SESSION_SECRET=your_session_secret_min_32_chars

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id

# OpenAI (for AI features)
OPENAI_API_KEY=sk-your-openai-api-key

# Collaboration Server
COLLAB_SERVER_PORT=3001
COLLAB_SERVER_HOST=0.0.0.0

# Storage
# For production, use S3 or similar
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=specforge-uploads

# Observability
# Optional: Add your monitoring service
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@specforge.example.com