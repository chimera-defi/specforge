# Database
DATABASE_URL=postgresql://localhost:5432/specforge_dev

# Next.js
NEXT_PUBLIC_SKIP_AUTH_OVERRIDE=true

# GitHub OAuth (for pilot/production auth)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# Session
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# AI/Agent Config
ANTHROPIC_API_KEY=your_anthropic_key

# Pilot access intake (optional)
# Local dev falls back to ws_demo when unset. Hosted/security-enforced runtime must set a private triage workspace.
SPECFORGE_PILOT_TRIAGE_WORKSPACE_ID=
# Set true for publicly reachable non-production hosts that still run NODE_ENV=development.
SPECFORGE_ENFORCE_HOSTED_SECURITY=false
SPECFORGE_PILOT_WEBHOOK_URL=

# Collaboration Server
HOCUSPOCUS_HOST=localhost
HOCUSPOCUS_PORT=1234
