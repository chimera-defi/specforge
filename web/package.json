{
  "name": "specforge-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:acceptance": "vitest run tests/acceptance/",
    "test:e2e": "playwright test",
    "screenshot:demo": "playwright test tests/demo.spec.ts --project=chromium",
    "parity:status": "node ../tools/specforge-parity-runner.mjs status",
    "parity:context": "node ../tools/specforge-parity-runner.mjs context",
    "parity:brief": "node ../tools/specforge-parity-runner.mjs brief",
    "parity:verify": "node ../tools/specforge-parity-runner.mjs verify",
    "parity:run": "node ../tools/specforge-parity-runner.mjs run",
    "parity:run:batch": "node ../tools/specforge-parity-runner.mjs run --until-clear --max-passes 3 --review-every 2",
    "parity:run:dry": "node ../tools/specforge-parity-runner.mjs run --dry-run --max-passes 1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "0.3.16",
    "@hocuspocus/provider": "3.4.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^10.72.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/extension-collaboration": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@types/pg": "8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "pg": "8.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "y-websocket": "^3.0.0",
    "yjs": "13.6.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.37",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "openapi-types": "^12.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
