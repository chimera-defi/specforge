# SpecForge Environment Variables
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Session Secrets (REQUIRED - generate strong random strings)
SPECFORGE_SESSION_SECRET=your-session-secret-at-least-32-characters-long
SPECFORGE_CSRF_SECRET=your-csrf-secret-at-least-32-characters-long

# GitHub OAuth (REQUIRED)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
SPECFORGE_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# Database (Optional - pglite is default)
# DATABASE_URL=postgresql://user:password@localhost:5432/specforge
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-password
# POSTGRES_DATABASE=specforge

# Redis (Optional - for production rate limiting)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Sentry (Optional - for production error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Email (Optional - for notifications)
EMAIL_PROVIDER=console
# SENDGRID_API_KEY=your-sendgrid-api-key
# MAILGUN_API_KEY=your-mailgun-api-key
# SES_ACCESS_KEY_ID=your-aws-access-key
# SES_SECRET_ACCESS_KEY=your-aws-secret-key
# SES_REGION=us-east-1

# Storage (Optional - for backups)
BACKUP_DESTINATION=.backups
BACKUP_RETENTION_DAYS=30

# API Configuration
API_VERSION=v1
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_DEFAULT=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_FLAGS_ENABLED=true

# Collab Server
COLLAB_SERVER_URL=http://localhost:4322
COLLAB_SERVER_PORT=4322

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# OpenTelemetry (Optional - for distributed tracing)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=specforge-web